------1 выбираем воркфлоу  
WITH WF as ( 
select t1.SUBJECT_AREA, t1.WORKFLOW_ID, t1.WORKFLOW_NAME, t1.WORKFLOW_COMMENTS
from rep_workflows t1
where t1.WORKFLOW_NAME = 'wf_nabs_scol_fl' ---- пишем название потока
),
------2 прогоняем форкфлоу через логи что бы получить исполняемые объекты
WF_LOG as (
select DISTINCT t_log.START_TIME , t_log.WORKFLOW_ID , tas.INSTANCE_NAME, tas.RUN_STATUS_CODE, tas.TASK_ID
from wf w, OPB_TASK_INST_RUN tas , OPB_WFLOW_RUN t_log 
where 
t_log.WORKFLOW_ID = w.WORKFLOW_ID
and 
t_log.START_TIME > (sysdate -1)
AND
tas.WORKFLOW_ID=t_log.WORKFLOW_ID
AND
t_log.WORKFLOW_RUN_ID = tas.WORKFLOW_RUN_ID
AND 
tas.RUN_STATUS_CODE = 1
AND 
tas.INSTANCE_NAME not in ('mux','Start','Decision','Email') -- убираем мусор
),
---- вяжем воркфлоу сессию и маппинг
WF_S_MAP as (
select 
OPB_SESSION.SESSION_ID,
OPB_SESSION.MAPPING_ID,
OPB_MAPPING.MAPPING_NAME,
WORKFLOW_ID
from
OPB_MAPPING, OPB_SESSION, WF_LOG WL
WHERE
OPB_MAPPING.MAPPING_ID = OPB_SESSION.MAPPING_ID AND
OPB_MAPPING.MAPPING_NAME not in ('m_Execute_SQL') AND -- убираем мусор
wl.task_id=OPB_SESSION.SESSION_ID
),

--- получаем название соурса и таргета
WF_TARGET as (
select g.TARGET_NAME, p.MAPPING_NAME from rep_targ_mapping g, wf_s_map p where g.MAPPING_NAME=p.MAPPING_NAME 
),
WF_SOURCE as (
select g.SOURCE_NAME, p.MAPPING_NAME from rep_src_mapping g, wf_s_map p where g.MAPPING_NAME=p.MAPPING_NAME 
)
--<<<<<<<<<<<<<<<<<<<<<< связываем все результаты WF WF_LOG WF_S_MAP WF_TARGET WF_SOURCE
select DISTINCT w.SUBJECT_AREA, w.WORKFLOW_ID, w.WORKFLOW_COMMENTS, wl.INSTANCE_NAME SESSION_NAME, wm.MAPPING_NAME, ws.SOURCE_NAME, wt.TARGET_NAME 
from 
WF w join WF_LOG wl on w.WORKFLOW_ID= wl.WORKFLOW_ID
join WF_S_MAP wm on wm.WORKFLOW_ID= wl.WORKFLOW_ID and wl.task_id=wm.SESSION_ID
join WF_TARGET wt on wt.mapping_name=wm.mapping_name
join WF_SOURCE ws on ws.mapping_name=wm.mapping_name 

